{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "app",
    "outDir": "dist",
    "newLine": "crlf",
    "sourceMap": true
  },
  "include": ["app/**/*.ts", "app/**/*.cts"]
}
